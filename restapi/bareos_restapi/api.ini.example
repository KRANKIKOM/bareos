[Director]
Name=bareos-dir
Address=127.0.0.1
Port=9101
# Director resource tree; client/job modify/delete edit files here and reload.
# The API needs write access to it (co-located with the director).
# ResourceDir=/etc/bareos/bareos-dir.d
# Shared cluster secret (same value as Ansible's bareos_common_cluster_secret).
# Enables POST /configuration/clients without a password: it is then derived
# as sha256(ClusterSecret + hostname + "fd"), matching the bareos_fd role.
# ClusterSecret=
# Consoles allowed to modify/delete client+job resource files, read FD secrets
# (fd-config) and use password derivation. These bypass per-console ACLs, so
# list only trusted, full-access consoles (comma-separated). Empty = nobody.
# AdminConsoles=restapi

[JWT]
# to get a string like this run:
# Secret key for JWT encryption. Warning: this is an example, do not use in production
# Use
# openssl rand -hex 32
# to generate your own key
# secret_key = 936959a2a6902056b924669796c74aad13b9da2b5cf637b70e377b3d7c29c6fb
algorithm = HS256
access_token_expire_minutes = 30
